# Legacy: production URL written by scripts/vercel-deploy-wizard.sh. The app
# does not read it - production deploys from `main` on Hostinger.
VERCEL_PRODUCTION_URL=

# Contact form delivery (Resend). Verify eastwards.co in Resend first; the
# acknowledgement to the visitor is sent from the same address.
RESEND_API_KEY=
CONTACT_EMAIL_TO=contact@eastwards.co

# Optional: second delivery to a JSON webhook (CRM, Slack, Zapier).
CONTACT_WEBHOOK_URL=
