# Legacy: production URL written by scripts/vercel-deploy-wizard.sh. The app
# does not read it - production deploys from `main` on Hostinger.
VERCEL_PRODUCTION_URL=

# Contact form delivery (Resend). Verify eastwards.co in Resend before using
# the domain sender. To test before verification, send from Resend's test
# address to your own inbox:
#   CONTACT_FROM="Eastwards Consulting <onboarding@resend.dev>"
#   CONTACT_EMAIL_TO=you@example.com
RESEND_API_KEY=
CONTACT_FROM="Eastwards Consulting <no-reply@eastwards.co>"
CONTACT_EMAIL_TO=contact@eastwards.co

# Optional: second delivery to a JSON webhook (CRM, Slack, Zapier).
CONTACT_WEBHOOK_URL=

# Careers applications (CV attached) go here. Optional: defaults to
# careers@eastwards.co. Uses the same RESEND_API_KEY and CONTACT_FROM.
CAREERS_EMAIL_TO=careers@eastwards.co
